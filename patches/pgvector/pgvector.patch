+/* Offsets share one origin; subtracting them gives a nonduplicated timeline. */
+static int64
+BuildTimeOffset(instr_time boundary, instr_time origin)
+{
+	INSTR_TIME_SUBTRACT(boundary, origin);
+	return (int64) INSTR_TIME_GET_MICROSEC(boundary);
+}
+
+static void
+AppendBuildPhase(StringInfo buf, const char *phase, int64 start, int64 end, bool applicable)
+{
+	appendStringInfo(buf, ",{\"phase\":\"%s\",\"start_us\":", phase);
+	if (applicable)
+		appendStringInfo(buf, INT64_FORMAT ",\"end_us\":" INT64_FORMAT "}", start, end);
+	else
+		appendStringInfoString(buf, "null,\"end_us\":null}");
+}
+
+/* Only the leader reports a successful AM call, not command/commit success. */
+static void
+ReportBuildTiming(HnswBuildState *buildstate, instr_time start, instr_time graphStart,
+				  instr_time walStart, instr_time walEnd, instr_time finished, bool needsWal)
+{
+	HnswGraphTiming *timing = &buildstate->graphTiming;
+	bool		spill = !INSTR_TIME_IS_ZERO(timing->spillRequested);
+	int64		setupEnd = BuildTimeOffset(graphStart, start);
+	int64		flushStart = BuildTimeOffset(timing->flushStarted, start);
+	int64		flushEnd = BuildTimeOffset(timing->flushFinished, start);
+	int64		memoryEnd = spill ? BuildTimeOffset(timing->spillRequested, start) : flushStart;
+	int64		graphEnd = spill ? BuildTimeOffset(buildstate->scanFinished, start) : flushEnd;
+	int64		walStartUs = BuildTimeOffset(walStart, start);
+	int64		walEndUs = BuildTimeOffset(walEnd, start);
+	int64		total = BuildTimeOffset(finished, start);
+	StringInfoData buf;
+
+	initStringInfo(&buf);
+	appendStringInfo(&buf, "{\"version\":1,\"status\":\"complete\",\"scope\":\"hnsw_build\","
+					 "\"clock\":\"elapsed_wall\",\"pid\":%d,\"index_oid\":%u,\"fork\":%d,"
+					 "\"parallel_workers\":%d,\"spill\":%s,\"total_us\":" INT64_FORMAT ","
+					 "\"phases\":[{\"phase\":\"setup\",\"start_us\":0,\"end_us\":" INT64_FORMAT "}",
+					 MyProcPid, RelationGetRelid(buildstate->index), buildstate->forkNum,
+					 buildstate->timingWorkers, spill ? "true" : "false", total, setupEnd);
+	AppendBuildPhase(&buf, "memory_build", setupEnd, memoryEnd, true);
+	AppendBuildPhase(&buf, "spill_drain", memoryEnd, flushStart, spill);
+	AppendBuildPhase(&buf, "flush", flushStart, flushEnd, true);
+	AppendBuildPhase(&buf, "disk_insert", flushEnd, graphEnd, spill);
+	AppendBuildPhase(&buf, "finalize", graphEnd, walStartUs, true);
+	AppendBuildPhase(&buf, "wal", walStartUs, walEndUs, needsWal);
+	AppendBuildPhase(&buf, "cleanup", walEndUs, total, true);
+	appendStringInfoString(&buf, "]}");
+	ereport(NOTICE, (errmsg_internal("hnsw build timing: %s", buf.data)));
+	pfree(buf.data);
+}
